# Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxx

# The inbox that receives portfolio messages.
CONTACT_TO_EMAIL=mdsafiul0073@gmail.com

# Use onboarding@resend.dev while testing. For production, use an address on
# a domain you have verified in Resend, for example portfolio@yourdomain.com.
CONTACT_FROM_EMAIL="Md Safiullah Portfolio <onboarding@resend.dev>"

# Admin dashboard login. Set these in Vercel for production.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-long-random-secret

# Optional but recommended on Vercel if you want messages visible in admin.
# Without this, message storage only works reliably in local development.
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
